# =====================================================================
# VENDOR STAGE (online) — does ALL network work, emits a build-ready,
# fully-vendored traefik source tree so the offline build needs no network:
#   - webui      : node24 + yarn4 (corepack) -> webui/static  (vite build,
#                  outDir ./static). Embedded by webui/embed.go //go:embed static.
#   - traefik-src: traefik v3.7.19 source with webui/static copied in,
#                  grpc + x/crypto x/net x/sys x/text + go-jose/v4, brotli and
#                  klauspost/compress raised to exact pinned floors (raise-only,
#                  re-checked by held() after tidy), `go mod vendor`. A sanity `go build ./cmd/traefik`
#                  proves the tree compiles + embeds the dashboard BEFORE we
#                  ship it to the hermetic offline build.
#   - chisel     : the runtime rootfs, cut by Canonical's chisel (pinned release and
#                  chisel-releases commit, checksummed) from Ubuntu's own .debs:
#                  rootfs.tar, debs/, packages.tsv, slices.txt and a generated dpkg
#                  status (chisel writes none); Dockerfile.offline.pinned lays it out
#                  FROM scratch
# Export:  docker build -f Dockerfile.vendor --target export \
#            --output type=local,dest=./vendored .
# =====================================================================

# --- 1) Build the dashboard (vite -> webui/static), embedded via go:embed ----
FROM node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4 AS webui
WORKDIR /w
RUN git clone --depth 1 --branch v3.7.19 -q https://github.com/traefik/traefik . && \
    test "$(git rev-parse HEAD)" = 7dafd6dba371bd1aee70c443c2975c229c969711 && \
    corepack enable && \
    cd webui && yarn install --immutable && yarn build && \
    test -f static/index.html && echo "webui static: $(ls -1 static | wc -l) entries"

# --- 2) Vendor the Go module tree (with the prebuilt dashboard embedded) ------
# Pinned to the SAME toolchain as Dockerfile.offline.pinned. A floating minor tag (1.26-bookworm) resolves to
# whatever the build host has cached, and the digest this kit used to pin under that tag was go1.26.4.
# Go 1.27 since v3.7.17: its go.mod says `go 1.27.0` (upstream builds its releases with Go 1.27 from v3.7.17,
# docs/content/migrate/v3.md), so under GOTOOLCHAIN=local a 1.26 toolchain cannot build it.
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS govendor
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch v3.7.19 -q https://github.com/traefik/traefik . && \
    test "$(git rev-parse HEAD)" = 7dafd6dba371bd1aee70c443c2975c229c969711
COPY --from=webui /w/webui/static/ webui/static/
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN v=$(go env GOVERSION) && echo "vendor toolchain $v" && \
    [ "$(printf '%s\n%s\n' go1.27.4 "$v" | sort -V | head -n1)" = go1.27.4 ] || \
    { echo "vendor toolchain is '$v', older than the go1.27.4 floor" >&2; exit 1; }
# CVE remediation: raise grpc + the golang.org/x/* deps that carry the bulk of
# Go-module CVEs (HTTP/2, crypto, text) to EXACT versions (mirrors strategy
# dep_bumps), then re-vendor and prove it still builds + embeds.
# floor() is gen_dockerfile's idiom: it raises a module only when the source pins
# it LOWER, never lowers it. A bare `go get m@vX` SETS the version and drags
# dependents down with it: chain 475 (v3.7.13) ran `go get grpc@v1.82.1` against
# upstream's v1.83.2, MVS pulled lego/v5 v5.4.1 -> v5.4.0, and pkg/provider/acme
# failed to compile (unknown field EnableCommonName). Never @latest: an unbounded
# floor resolves differently on every vendor run.
# floor() fails closed (L-A133): `go list -mod=mod`, and only "not a known dependency" skips a module; any other
# error (a missing go.sum entry after an earlier raise, the proxy unreachable) stops the step instead of skipping
# every later floor, as caddy chain 741 did. held() re-checks every floor after `go mod tidy` and stops the step
# when one did not take.
RUN floor() { e=$(mktemp); cur=$(go list -mod=mod -m -f '{{.Version}}' "$1" 2>"$e") || \
        { grep -q 'not a known dependency' "$e" && return 0; cat "$e" >&2; return 1; }; [ -n "$cur" ] || return 0; \
      [ "$(printf '%s\n%s\n' "$cur" "$2" | sort -V | tail -1)" = "$cur" ] || go mod edit -require="$1@$2"; } && \
    held() { e=$(mktemp); cur=$(go list -m -f '{{.Version}}' "$1" 2>"$e") || \
        { grep -q 'not a known dependency' "$e" && return 0; cat "$e" >&2; return 1; }; \
      [ "$(printf '%s\n%s\n' "$cur" "$2" | sort -V | tail -1)" = "$cur" ] || \
        { echo "floor $1 $2 did not take: the module resolved to $cur" >&2; return 1; }; echo "held $1 $cur (floor $2)"; } && \
    floor google.golang.org/grpc v1.83.2 && \
    floor golang.org/x/crypto v0.58.0 && \
    floor golang.org/x/net v0.62.0 && \
    floor golang.org/x/sys v0.49.0 && \
    floor golang.org/x/text v0.43.0 && floor github.com/go-jose/go-jose/v4 v4.1.6 && \
    floor github.com/andybalholm/brotli v1.2.7 && \
    floor github.com/klauspost/compress v1.20.3 && \
    go mod tidy && \
    held google.golang.org/grpc v1.83.2 && held golang.org/x/crypto v0.58.0 && held golang.org/x/net v0.62.0 && held golang.org/x/sys v0.49.0 && held golang.org/x/text v0.43.0 && held github.com/go-jose/go-jose/v4 v4.1.6 && \
    held github.com/andybalholm/brotli v1.2.7 && held github.com/klauspost/compress v1.20.3 && \
    go mod vendor && \
    go build -trimpath -ldflags='-s -w -X github.com/traefik/traefik/v3/pkg/version.Version=3.7.19' \
        -o /tmp/traefik ./cmd/traefik && \
    /tmp/traefik version && \
    rm -rf .git
# ^ strip the upstream clone's .git: the vendored tree ships INSIDE the kit, and
#   build_kit's L-009 `git init && git add -A` (to serve the hermetic git-context)
#   rejects a nested repo with "another git repository inside your current repository".

# chiselled runtime (runtime_base): the files the slices need, cut from Ubuntu's own .debs by Canonical's chisel
FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5 AS chiselcut
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl file zstd && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/chisel.tgz https://github.com/canonical/chisel/releases/download/v1.5.1/chisel_v1.5.1_linux_amd64.tar.gz && \
    echo "89612f46de83e850aae11fca26a32a22cc2964891f2cc538211b906787d2b83e4496fa203a5074e06a9932f1fbe84a73  /tmp/chisel.tgz" | sha384sum -c - && tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel && \
    curl -fsSL -o /tmp/releases.tgz https://github.com/canonical/chisel-releases/archive/f2600d3aa90123db6d44bb1441a99afc8b5847d9.tar.gz && \
    echo "e5b4484bb283149ed7fc0f42ad2194fed28cae0bf1036704853d60ec31298bef  /tmp/releases.tgz" | sha256sum -c - && \
    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying coreutils_chown openssl_bins libcap2-bin_bins
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
    for f in /cache/chisel/sha256/* /cache/chisel/sha512/*; do [ -f "$f" ] && file "$f" | grep -q "Debian binary package" || continue; \
      p=$(dpkg-deb -f "$f" Package); v=$(dpkg-deb -f "$f" Version); \
      cp "$f" "/chisel/debs/${p}_${v}.deb"; printf '%s\t%s\t%s\n' "$p" "$v" "$(sha256sum < "$f" | cut -c1-64)" >> /chisel/packages.tsv; done; \
    [ -s /chisel/packages.tsv ] || { echo "no .deb found in the chisel cache" >&2; exit 1; }; \
    LC_ALL=C sort -o /chisel/packages.tsv /chisel/packages.tsv; \
    cut -f1,2 /chisel/packages.tsv | while IFS="$(printf '\t')" read -r p v; do \
      dpkg-deb -f "/chisel/debs/${p}_${v}.deb" | sed '/^Package:/a Status: install ok installed' >> /tmp/status; echo >> /tmp/status; done; \
    install -m 0644 /tmp/status /rootfs/var/lib/dpkg/status; \
    mkdir -p /rootfs/var/lib/dpkg/info; [ -s /rootfs/var/lib/chisel/manifest.wall ] || \
      { echo "no chisel manifest (/var/lib/chisel/manifest.wall): the base-files_chisel slice is missing" >&2; exit 1; }; \
    zstd -dc /rootfs/var/lib/chisel/manifest.wall | grep '"kind":"path"' | \
      sed -n 's/.*"path":"\([^"]*\)".*"slices":\[\([^]]*\)\].*/\1 \2/p' | \
      while read -r path slices; do path=${path%/}; if [ -z "$path" ]; then continue; fi; \
        for s in $(echo "$slices" | tr -d '"' | tr ',' ' '); do echo "$path" >> "/rootfs/var/lib/dpkg/info/${s%%_*}.list"; done; done; \
    cut -f1 /chisel/packages.tsv | while read -r p; do l="/rootfs/var/lib/dpkg/info/$p.list"; [ -f "$l" ] || : > "$l"; \
      LC_ALL=C sort -u -o "$l" "$l"; \
      while read -r f; do if [ -f "/rootfs$f" ] && [ ! -L "/rootfs$f" ]; then (cd /rootfs && md5sum "${f#/}"); fi; done < "$l" \
        > "/rootfs/var/lib/dpkg/info/$p.md5sums"; done; \
    [ "$(ls /rootfs/var/lib/dpkg/info/*.md5sums | wc -l)" = "$(wc -l < /chisel/packages.tsv)" ] || \
      { echo "/var/lib/dpkg/info does not name every package of the cut" >&2; exit 1; }; \
    { echo "chisel v1.5.1"; echo "chisel-releases f2600d3aa90123db6d44bb1441a99afc8b5847d9"; for s in base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying coreutils_chown openssl_bins libcap2-bin_bins; do echo "$s"; done; } > /chisel/slices.txt; \
    tar --sort=name --numeric-owner --format=posix --pax-option=delete=atime,delete=ctime -cf /chisel/rootfs.tar -C /rootfs . && \
    echo "chiselled rootfs: $(wc -l < /chisel/packages.tsv) packages, $(du -sh /rootfs | cut -f1)"
# CVE floors on OS packages mirror strategies/traefik.json apt_refresh (hand kits do not read it): a package
# of the cut must be at or above its fixed version, else the vendor run fails here instead of shipping it; a floor
# whose package the cut does not carry has nothing to raise (the image does not ship it).
RUN atleast() { v=$(awk -F'\t' -v p="$1" '$1 == p {print $2}' /chisel/packages.tsv); \
      if [ -z "$v" ]; then echo "apt floor $1 $2: not in the cut"; return 0; fi; \
      dpkg --compare-versions "$v" ge "$2" || { echo "apt floor $1 $2 did not take: $v" >&2; return 1; }; \
      echo "apt floor $1 $2: $v"; } && \
    atleast apt 2.8.4ubuntu0.1 && atleast libapt-pkg6.0t64 2.8.4ubuntu0.1 && atleast libpcre2-8-0 10.42-4ubuntu2.2 && atleast libc6 2.39-0ubuntu8.12

FROM scratch AS export
COPY --from=govendor /src /traefik-src
COPY --from=chiselcut /chisel /chisel
